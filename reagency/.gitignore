# Build output
build/
bin/

# Runtime-generated distributed config (a stale one can force a non-primary launch -> black screen)
distributed_app.toml

# Offline factory intermediates (regenerate via factory/)
factory/work/
factory/*.zip

# NOTE: assets/ (points.bin, edges.bin, labels.txt, manifest.json, atlas_0.png) ARE
# committed on purpose — they are a few MB and this is how they reach the Mac preview
# and every AlloSphere render node via `git pull`, instead of per-node scp. Regenerate
# anytime with factory/make_assets.sh.
#
# The repo-root .gitignore has a blanket `assets/` rule (for build output); the
# negation below re-includes THIS project's data assets, which are intentionally
# tracked. Without it `git add reagency/assets` silently adds nothing.
!assets/
!assets/**

# EXCEPTION: vessel.wswv is large (~57 MB) and regenerable from factory/ (LGM image-to-3D),
# distributed via the Colab asset zip — keep it OUT of git (it would trip GitHub's >50 MB
# warning). This re-exclusion must come AFTER the !assets/** re-include to win (last match).
assets/vessel.wswv

# v2 Phase-2 dreams: the raw dream PNGs + emergence frames (~92 MB) come from the Qwen Colab run
# and are regenerable (re-download + bake) — keep them OUT of git. The galaxy itself (points.bin/
# edges.bin with the 36 concatenated dream nodes) and the small dream_provenance.json ARE tracked.
assets/dreams/

# Local backups of pre-install galaxies (not for the repo)
assets_preview_877/
assets_pre_qwen_*/

# Baked dream/emergence atlases: regenerable locally via v2/bake_dreams.py + v2/bake_emergence.py.
# emergence_atlas.png (~29 MB) is too big for git; the small credits_atlas + the *_index/_pos txt
# (the source-of-truth metadata) and dream_atlas.png stay tracked.
v2/emergence_atlas.png

# Phase-2 2a voice WAVs — regenerable via v2/bake_voices.py (macOS say), not committed
assets/audio/voice_*.wav
